<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <version>1.0.0</version>
    <!-- Unique identifier of the plugin -->
    <id>dev.c9tech.intellij-plugin.entity-utils</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>EntityUtils</name>

    <!-- A displayed Vendor name or Organization ID on Marketplace -->
    <vendor email="contact@c9tech.dev" url="https://c9tech.dev">c9tech</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    <h3>EntityUtils - Smart Entity & DTO Mapping Generator</h3>
    <p>Automate DTO creation and Entity-DTO mapper generation directly in IntelliJ IDEA with Java 17 support.</p>
    <ul>
        <li><b>EntityUtils: Generate DTO from Entity:</b> Pick fields, customize types, choose style (Standard Java Bean with Getters/Setters, Lombok, or Java 17 Record), customize package and class name.</li>
        <li><b>EntityUtils: Generate EntityMapper:</b> Auto-generate null-safe converter methods between Entity and DTO (Single object converter, List converter, Reverse converter, and Merge/Update methods).</li>
        <li><b>Smart Type Conversion:</b> Automatically handles Date &lt;-&gt; Timestamp conversions, String &lt;-&gt; Number conversions, and custom field types.</li>
        <li><b>Pure PSI Integration:</b> High performance, zero runtime reflection, format-compliant code generation respecting your project code style.</li>
    </ul>
    ]]></description>

    <change-notes><![CDATA[
    <h4>1.0.0</h4>
    <ul>
        <li>Initial release with DTO Generator and EntityMapper Generator.</li>
        <li>Java 17 support.</li>
        <li>Null safety checks, list converters, and merge methods.</li>
    </ul>
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="EntityUtils Notification Group" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Standalone Actions registered to GenerateGroup (Alt + Insert) -->
        <action id="dev.c9tech.entityutils.action.GenerateDtoAction"
                class="dev.c9tech.entityutils.action.GenerateDtoAction"
                text="EntityUtils: Generate DTO from Entity..."
                description="Generates a DTO class based on the selected Entity class">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt D"/>
        </action>

        <action id="dev.c9tech.entityutils.action.GenerateMapperAction"
                class="dev.c9tech.entityutils.action.GenerateMapperAction"
                text="EntityUtils: Generate EntityMapper..."
                description="Generates EntityMapper methods or class between Entity and DTO">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt M"/>
        </action>

        <!-- Context menu group: Right Click -> EntityUtils -->
        <group id="dev.c9tech.entityutils.group" text="EntityUtils" description="EntityUtils helper actions" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>

            <reference ref="dev.c9tech.entityutils.action.GenerateDtoAction"/>
            <reference ref="dev.c9tech.entityutils.action.GenerateMapperAction"/>
        </group>
    </actions>
</idea-plugin>
